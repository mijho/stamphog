DATABASE_PATH=./data/stamphog.db
API_PORT=8787
VITE_API_URL=http://localhost:8787

SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
CHANNEL_IDS=

# Read API access. Local development defaults to anonymous access.
# When READ_AUTH_IDENTITY_HEADER and READ_AUTH_ALLOWED_IDENTITIES are set,
# requests to /api/* must present a matching identity header.
# READ_AUTH_ALLOW_ANONYMOUS=false rejects local development access.
READ_AUTH_IDENTITY_HEADER=
READ_AUTH_ALLOWED_IDENTITIES=
READ_AUTH_ALLOW_ANONYMOUS=true

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
